# ------------------------------------------------------------------------------
# Build Stage: Compile static binary using rust:alpine with musl target
# ------------------------------------------------------------------------------
FROM rust:alpine AS builder

RUN apk add --no-cache musl-dev gcc make binutils

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY server server
COPY core-client core-client
COPY cli cli
COPY bench bench
COPY clients/python clients/python

# Build statically linked stripped release binary
RUN cargo build --release -p aerokv-server && \
    strip /build/target/release/aerokv-server

# ------------------------------------------------------------------------------
# Runtime Stage: Google Cloud Run optimized minimal container
# ------------------------------------------------------------------------------
FROM alpine:3.20

RUN apk add --no-cache ca-certificates

# Copy compiled binary
COPY --from=builder /build/target/release/aerokv-server /usr/local/bin/aerokv-server

# Cloud Run defaults: port injected via PORT env var (default 8080)
# Note: Memory ceiling is auto-detected from container cgroup limit unless AEROKV_MAX_MEM_MB is set
ENV PORT=8080

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/aerokv-server"]
